SUPABASE_ANON_KEY=your-anon-key

# Web OAuth Client ID from Google Cloud / Firebase (Authentication ->
# Sign-in method -> Google). Must match the Client ID(s) configured in
# Supabase Dashboard -> Authentication -> Providers -> Google.
