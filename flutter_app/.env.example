# Optional, iOS only.
GOOGLE_IOS_CLIENT_ID=

ADMOB_APP_ID_ANDROID=ca-app-pub-3940256099942544~3347511713
ADMOB_APP_ID_IOS=ca-app-pub-3940256099942544~1458002511

# Where the in-app "Donate" button/prompt sends people (PayPal.me,
# Stripe Payment Link, Buy Me a Coffee, Patreon, etc). Leave blank to
# show "coming soon" instead of a broken link.
DONATION_URL=
